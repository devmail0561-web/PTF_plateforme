# PTF Service — Variables d'environnement production

# ── Postgres ──────────────────────────────────────────────────────────────────
SERVICE_POSTGRES_USER=ptf_service
SERVICE_POSTGRES_PASSWORD=<mot_de_passe_fort>

# ── Redis ─────────────────────────────────────────────────────────────────────
SERVICE_REDIS_PASSWORD=<mot_de_passe_fort>

# ── Backend ───────────────────────────────────────────────────────────────────
SERVICE_JWT_SECRET=<secret_jwt_256_bits_différent_du_framework>
SERVICE_CORS_ORIGIN=https://app.ptf-service.dev
PTF_FRAMEWORK_API=https://api.ptf-framework.dev/graphql

# ── SMTP (notifications email) ────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<sendgrid_api_key>
SMTP_FROM=noreply@ptf-service.dev

# ── Contrat escrow service (adresse de réception dépôts) ─────────────────────
PTF_CONTRACT_POLYGON=

# ── Docker image ──────────────────────────────────────────────────────────────
GITHUB_REPOSITORY_OWNER=devmail0561-web
IMAGE_TAG=latest
