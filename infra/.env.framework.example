# PTF Framework — Variables d'environnement production
# Copier en .env et remplir avant docker compose up

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=ptf
POSTGRES_PASSWORD=<mot_de_passe_fort>

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<mot_de_passe_fort>

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=<secret_jwt_256_bits>
CORS_ORIGIN=https://app.ptf-service.dev

# ── Blockchain ────────────────────────────────────────────────────────────────
DEFAULT_CHAIN=polygon
SIGNER_PRIVATE_KEY=<clé_privée_opérateur_sans_0x>
RPC_POLYGON=https://polygon-rpc.com

# Contrats déployés (remplir après deploy-amoy.sh)
CONTRACT_PROJECT_REGISTRY_POLYGON=
CONTRACT_ESCROW_VAULT_POLYGON=
CONTRACT_CREDIT_TOKEN_POLYGON=
CONTRACT_REPUTATION_REGISTRY_POLYGON=

# ── Docker image ──────────────────────────────────────────────────────────────
GITHUB_REPOSITORY_OWNER=devmail0561-web
IMAGE_TAG=latest
