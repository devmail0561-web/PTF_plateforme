generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  githubId     String?  @unique
  githubHandle String?
  isBanned     Boolean  @default(false)
  banReason    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallets      WalletLink[]
  projects     Project[]
  submissions  Submission[]
  reputation   Reputation?
  reports      Report[]     @relation("ReportedUser")
  reportsFiled Report[]     @relation("ReporterUser")
  sessions     Session[]
}

model WalletLink {
  id        String   @id @default(cuid())
  userId    String
  chain     String
  address   String
  isPrimary Boolean  @default(false)
  linkedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([userId])
}

model Project {
  id           String   @id
  networkId    String?  @unique
  name         String
  type         String
  rewardMode   String
  chain        String
  token        String?
  repoType     String
  repoUrl      String?
  tempRepoUrl  String?
  syncStatus   String   @default("synced")
  lastSyncAt   DateTime?
  escrowBalance Float   @default(0)
  merkleRoot   String?
  status       String   @default("draft")
  language     String?
  stack        String[]
  description  String?
  ownerAddress String
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User?              @relation(fields: [ownerId], references: [id])
  tasks        Task[]
  contributors ContributorRecord[]

  @@index([ownerAddress])
  @@index([status])
  @@index([rewardMode])
}

model Task {
  id                String    @id
  projectId         String
  parentId          String?
  networkId         String?
  title             String
  type              String
  priority          String
  status            String    @default("open")
  context           String    @db.Text
  objective         String    @db.Text
  deliverable       String    @db.Text
  outOfScope        String[]
  constraints       Json
  verificationSteps Json
  claimCriteria     Json
  punishments       Json
  scoring           Json
  reputationPoints  Int       @default(0)
  dependencies      String[]
  blockedBy         String[]
  unlocks           String[]
  duration          String    @default("30d")
  claimedAt         DateTime?
  deadline          DateTime?
  devAddress        String?
  conditionsHash    String?
  eip712Signature   String?
  rewardAmount      Float?
  rewardToken       String?
  commitHash        String?
  branchRef         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([projectId])
  @@index([status])
  @@index([devAddress])
  @@index([deadline])
}

model Submission {
  id              String    @id @default(cuid())
  taskId          String
  devAddress      String
  userId          String?
  commitHash      String
  branchRef       String
  status          String    @default("pending")
  testResults     Json?
  validationJobId String?
  submittedAt     DateTime  @default(now())
  completedAt     DateTime?

  task Task  @relation(fields: [taskId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([devAddress])
}

model Reputation {
  id             String   @id @default(cuid())
  userId         String   @unique
  totalPoints    Int      @default(0)
  level          String   @default("Unranked")
  completedTasks Int      @default(0)
  updatedAt      DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  history ReputationEvent[]
}

model ReputationEvent {
  id           String   @id @default(cuid())
  reputationId String
  delta        Int
  reason       String
  taskId       String?
  chain        String?
  txHash       String?
  createdAt    DateTime @default(now())

  reputation Reputation @relation(fields: [reputationId], references: [id])

  @@index([reputationId])
}

model PunishmentRecord {
  id                String   @id @default(cuid())
  devAddress        String
  taskId            String
  type              String
  creditsPenalty    Float?
  reputationPenalty Int
  txHash            String?
  executedAt        DateTime @default(now())

  @@index([devAddress])
  @@index([taskId])
}

model ContributorRecord {
  id             String    @id @default(cuid())
  projectId      String
  devAddress     String
  githubHandle   String?
  tasksCompleted Int       @default(0)
  totalEarned    Float     @default(0)
  joinedAt       DateTime  @default(now())
  lastActivity   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, devAddress])
  @@index([projectId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  taskId         String?
  reason         String
  evidence       String   @db.Text
  status         String   @default("pending")
  resolution     String?
  createdAt      DateTime @default(now())

  reporter     User @relation("ReporterUser", fields: [reporterId], references: [id])
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id])

  @@index([reportedUserId])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// UTXO model — each PTF credit is a discrete, cryptographically-signed spendable unit.
// Inspired by Bitcoin UTXO: spending 200 PTF = selecting unspent outputs that sum to >=200,
// each carrying an EIP-712 signature from PTF proving its origin (task, project, chain).
model CreditUTXO {
  id              String   @id            // keccak256(owner + sourceId + amount_hex + createdAt_ms)
  ownerAddress    String
  amount          Float                   // PTF amount (6 decimal precision, e.g. 150.000000)
  sourceType      String                  // task_reward | deposit | bridge_in | change
  sourceId        String?                 // taskId for rewards; deposit txHash for deposits
  projectId       String?
  chain           String
  eip712Signature String                  // PTF-signed: (utxoId, owner, amount, sourceId, chain) — proves origin
  txHash          String?                 // on-chain tx that created this UTXO (if applicable)
  status          String   @default("unspent")  // unspent | spent | locked
  spentInTxId     String?                 // CreditTransaction.id that consumed this UTXO
  createdAt       DateTime @default(now())

  @@index([ownerAddress, status])
  @@index([sourceId])
  @@index([spentInTxId])
  @@index([createdAt])
}

// A PTF credit transaction: consumes N input UTXOs, produces M output UTXOs (change).
// The proofHash = keccak256 of all input EIP-712 signatures — independently verifiable.
model CreditTransaction {
  id          String   @id            // keccak256(devAddress + inputIds[] + createdAt_ms)
  type        String                  // withdrawal | punishment | bridge_out
  devAddress  String
  inputIds    String[]                // CreditUTXO.id[] consumed (inputs)
  outputIds   String[]                // CreditUTXO.id[] created (change outputs)
  inputTotal  Float                   // sum of all inputs
  outputTotal Float                   // sum of change outputs
  netAmount   Float                   // inputTotal - outputTotal (what actually left)
  chain       String
  destination String?                 // target wallet for withdrawal
  txHash      String?                 // on-chain burn tx
  proofHash   String                  // keccak256(all input UTXO eip712Signatures) — auditable
  createdAt   DateTime @default(now())

  @@index([devAddress])
  @@index([createdAt])
}

// Chronological ledger — kept alongside UTXOs for accounting display.
// Written by TaskService, PunishmentService, WalletService.
model CreditEvent {
  id          String   @id @default(cuid())
  devAddress  String
  type        String   // reward_earned | punishment_deducted | soft_locked | soft_unlocked | deposit | withdrawal | bridge_out | bridge_in
  direction   String   // credit | debit
  amount      Float
  utxoId      String?  // CreditUTXO.id this event created or consumed
  taskId      String?
  projectId   String?
  chain       String
  txHash      String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([devAddress])
  @@index([utxoId])
  @@index([taskId])
  @@index([createdAt])
}

model NetworkBroadcast {
  id          String   @id @default(cuid())
  type        String
  projectId   String?
  taskId      String?
  payload     Json
  signature   String
  chain       String
  txHash      String?
  broadcastAt DateTime @default(now())

  @@index([type])
  @@index([projectId])
}
