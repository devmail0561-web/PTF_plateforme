generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id
  networkId    String?  @unique
  name         String
  type         String
  rewardMode   String
  chain        String
  token        String?
  repoType     String
  repoUrl      String?
  tempRepoUrl  String?
  syncStatus   String   @default("synced")
  lastSyncAt   DateTime?
  escrowBalance Float   @default(0)
  merkleRoot   String?
  status       String   @default("draft")
  language     String?
  stack        String[]
  description  String?
  ownerAddress String
  // Open-source verification — populated at create() and re-checked at activate().
  isOpenSource       Boolean  @default(false) // true only after GitHub API confirms public + OSI license
  license            String?                  // SPDX identifier, e.g. "MIT", "GPL-3.0"
  licenseVerifiedAt  DateTime?               // last time the GitHub check passed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks        Task[]
  contributors ContributorRecord[]

  @@index([ownerAddress])
  @@index([status])
  @@index([rewardMode])
}

model Task {
  id                String    @id
  projectId         String
  parentId          String?
  networkId         String?
  title             String
  type              String
  priority          String
  status            String    @default("open")
  context           String    @db.Text
  objective         String    @db.Text
  deliverable       String    @db.Text
  outOfScope        String[]
  constraints       Json
  verificationSteps Json
  claimCriteria     Json
  punishments       Json
  scoring           Json
  reputationPoints  Int       @default(0)
  dependencies      String[]
  blockedBy         String[]
  unlocks           String[]
  duration          String    @default("30d")
  claimedAt         DateTime?
  deadline          DateTime?
  devAddress        String?
  conditionsHash    String?
  eip712Signature   String?
  // F10 — Decimal pour éviter la perte de précision IEEE 754 des montants financiers.
  rewardAmount      Decimal?  @db.Decimal(18, 6)
  rewardToken       String?
  commitHash        String?
  branchRef         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([projectId])
  @@index([status])
  @@index([devAddress])
  @@index([deadline])
}

model Submission {
  id              String    @id @default(cuid())
  taskId          String
  devAddress      String
  commitHash      String
  branchRef       String
  status          String    @default("pending")
  testResults     Json?
  validationJobId String?
  submittedAt     DateTime  @default(now())
  completedAt     DateTime?

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([devAddress])
}

model PunishmentRecord {
  id                String   @id @default(cuid())
  devAddress        String
  taskId            String
  type              String
  creditsPenalty    Float?
  reputationPenalty Int
  txHash            String?
  executedAt        DateTime @default(now())

  @@index([devAddress])
  @@index([taskId])
}

model ContributorRecord {
  id             String    @id @default(cuid())
  projectId      String
  devAddress     String
  githubHandle   String?
  tasksCompleted Int       @default(0)
  // F10 — Decimal pour cohérence avec Task.rewardAmount.
  totalEarned    Decimal   @default(0) @db.Decimal(18, 6)
  joinedAt       DateTime  @default(now())
  lastActivity   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, devAddress])
  @@index([projectId])
}

model NetworkBroadcast {
  id          String   @id @default(cuid())
  type        String
  projectId   String?
  taskId      String?
  payload     Json
  signature   String
  chain       String
  txHash      String?
  broadcastAt DateTime @default(now())

  @@index([type])
  @@index([projectId])
}

// Tracks the last on-chain block processed per chain/contract pair.
// The reconciliation worker resumes from this checkpoint after a crash or restart.
model SyncCheckpoint {
  id              String   @id @default(cuid())
  chain           String
  contractAddress String
  lastBlock       Int
  updatedAt       DateTime @updatedAt

  @@unique([chain, contractAddress])
}
