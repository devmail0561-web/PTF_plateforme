# Database
DATABASE_URL="postgresql://ptf:ptf@localhost:5432/ptf_dev"

# Redis — dev (single instance, falls back automatically)
REDIS_URL="redis://localhost:6379"

# Redis A — Sentinel (locks, rate-limit, nonces) — REQUIRED in production
# REDIS_SENTINEL_1=redis-sentinel-1.internal:26379
# REDIS_SENTINEL_2=redis-sentinel-2.internal:26379
# REDIS_SENTINEL_3=redis-sentinel-3.internal:26379
# REDIS_SENTINEL_MASTER_NAME=ptf-sentinel-master

# Redis B — Cluster (BullMQ queues, cache) — REQUIRED in production
# REDIS_CLUSTER_1=redis-cluster-1.internal:6380
# REDIS_CLUSTER_2=redis-cluster-2.internal:6380
# REDIS_CLUSTER_3=redis-cluster-3.internal:6380

# JWT
JWT_SECRET="change-me-in-production"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Default chain (dev: mock, prod: polygon)
DEFAULT_CHAIN=mock

# Blockchain (prod only — laisser vide en dev, MockChainAdapter est utilisé)
SIGNER_PRIVATE_KEY=""
RPC_POLYGON="https://polygon-rpc.com"
RPC_ETHEREUM="https://ethereum-rpc.publicnode.com"

# Smart contracts (prod — déployés après audit)
CONTRACT_PROJECT_REGISTRY_POLYGON=""
CONTRACT_ESCROW_VAULT_POLYGON=""
CONTRACT_CREDIT_TOKEN_POLYGON=""
CONTRACT_REPUTATION_REGISTRY_POLYGON=""
