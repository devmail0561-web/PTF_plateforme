    "gray-matter": "^4.0.3",
    "graphql-request": "^6.1.0",
    "inquirer": "^9.3.7",
    "js-yaml": "^4.1.0",
    "open": "^10.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.1",
    "tsx": "^4.19.1",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
