{
  "name": "@ptf/cli",
  "version": "0.1.0",
  "description": "PTF — Pay-Task Framework CLI",
  "type": "module",
  "bin": {
    "ptf": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
